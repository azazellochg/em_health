      "panel-12": {
        "kind": "Panel",
        "spec": {
          "id": 12,
          "title": "Projection vacuum",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${sourceTEM}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "-- Step 1: Decide pressure param name\nWITH selected_param_name AS (\n  SELECT\n    CASE\n      WHEN template = 'tundra' THEN 'PIRcoPressure'\n      WHEN template = 'talos' THEN 'PPmPressure'\n      ELSE 'CCGpPressure'\n    END AS param_name\n  FROM instruments\n  WHERE id = $instrument\n),\n\n-- Step 3: Get param_id for selected pressure parameter\nmatching_param AS (\n  SELECT param_id\n  FROM parameters p\n  JOIN selected_param_name s ON p.param_name = s.param_name\n  WHERE p.instrument_id = $instrument\n)\n\n-- Final: Fetch pressure time series\nSELECT\n  time,\n  value AS pressure\nFROM unnest((\n  SELECT lttb(\n    time,\n    value_num,\n    2 * (($__to - $__from) / $__interval_ms)::int\n  )\n  FROM data\n  WHERE instrument_id = $instrument\n    AND param_id = (SELECT param_id FROM matching_param)\n    AND $__timeFilter(time)\n))\nORDER BY 1;\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
