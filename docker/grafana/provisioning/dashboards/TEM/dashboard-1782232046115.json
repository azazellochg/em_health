      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "$instrument",
          "description": "Beam time is based on the vacuum state of each instrument",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${sourceTEM}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH total AS (\n  SELECT SUM(seconds) AS total_seconds\n  FROM vacuum_state_daily\n  WHERE $__timeFilter(day)\n    AND instrument_id = $instrument\n)\nSELECT\n  v.state,\n  SUM(v.seconds) AS duration_seconds,\n  ROUND(100.0 * SUM(v.seconds) / NULLIF(t.total_seconds, 0), 2) AS percentage\nFROM vacuum_state_daily v\nCROSS JOIN total t\nWHERE $__timeFilter(v.day)\n  AND v.instrument_id = $instrument\nGROUP BY v.state, t.total_seconds\nORDER BY percentage DESC;\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
