                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  'TEM server' AS name,\n  CASE d.value_num\n    WHEN 1 THEN 'Up'\n    WHEN 0 THEN 'Down'\n  END AS value_num,\n  d.time\nFROM\n  data d\nWHERE\n  d.instrument_id = $instrument\n  AND d.param_id = $param_id_server\nORDER BY\n  d.time DESC\nLIMIT\n  1",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
