      "panel-26": {
        "kind": "Panel",
        "spec": {
          "id": 26,
          "title": "",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${sourceTEM}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH family_param AS (\n    SELECT param_id, enum_id\n    FROM parameters\n    WHERE instrument_id = $instrument\n      AND param_name = 'ProductFamily'\n),\n\nserial_param AS (\n    SELECT param_id\n    FROM parameters\n    WHERE instrument_id = $instrument\n      AND param_name = 'SerialNumber'\n),\n\nlatest_product_family AS (\n    SELECT e.member_name AS product_family\n    FROM data d\n    JOIN family_param p\n      ON d.param_id = p.param_id\n     AND d.instrument_id = $instrument\n     AND d.value_num > 0\n     AND d.time > now() - interval '365 days'\n    JOIN enum_values e\n      ON e.enum_id = p.enum_id\n     AND e.value = d.value_num\n    ORDER BY d.time DESC\n    LIMIT 1\n),\n\nlatest_serial AS (\n    SELECT d.value_num AS serial\n    FROM data d\n    JOIN serial_param sp\n      ON d.param_id = sp.param_id\n    WHERE d.instrument_id = $instrument\n      AND d.value_num > 0\n      AND d.time > now() - interval '365 days'\n    ORDER BY d.time DESC\n    LIMIT 1\n),\n\ninstrument_times AS (\n    SELECT\n        (SELECT time FROM data WHERE instrument_id = $instrument ORDER BY time ASC LIMIT 1) AS oldest_data,\n        (SELECT time FROM data WHERE instrument_id = $instrument ORDER BY time DESC LIMIT 1) AS latest_data\n)\n\nSELECT i.name AS \"Name\",\n       ls.serial AS \"Serial\",\n       i.serial AS \"D-number\",\n       i.model AS \"Model\",\n       lpf.product_family AS \"Product family\",\n       i.server AS \"Server IP\",\n       i.ds_version AS \"Data services\",\n       it.oldest_data AS \"Oldest data\",\n       it.latest_data AS \"Latest data\" \nFROM instruments i \nLEFT JOIN latest_product_family lpf ON TRUE\nLEFT JOIN latest_serial ls ON TRUE\nLEFT JOIN instrument_times it ON TRUE\nWHERE i.id = $instrument;\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
