                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH target_param AS (\n  SELECT param_id, enum_id\n  FROM parameters\n  WHERE instrument_id = $instrument AND param_id = $param_id_filter\n)\nSELECT\n  'Energy filter' AS name,\n  ev.member_name AS value_num,\n  d.time\nFROM target_param tp\nJOIN data d\n  ON d.param_id = tp.param_id\n  AND d.instrument_id = $instrument\nJOIN enum_values ev\n  ON ev.enum_id = tp.enum_id\n  AND d.value_num = ev.value\nWHERE $param_id_filter != 0\nORDER BY d.time DESC\nLIMIT 1\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
