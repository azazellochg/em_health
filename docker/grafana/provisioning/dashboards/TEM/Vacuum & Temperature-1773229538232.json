          "rawQuery": true,
          "rawSql": "WITH matching_param AS (\n  SELECT param_id\n  FROM parameters\n  WHERE instrument_id = $instrument\n    AND param_name = 'PPal'\n    AND subsystem = 'Krios Parameters'\n    AND component = 'Vacuum'\n)\n\nSELECT\n  time,\n  value AS \"PPal pressure\"\nFROM unnest(\n  (\n    SELECT lttb(\n      time,\n      value_num,\n      2 * (($__to - $__from) / $__interval_ms)::int\n    )\n    FROM data\n    WHERE instrument_id = $instrument\n      AND param_id = (SELECT param_id FROM matching_param)\n      AND $__timeFilter(time)\n  )\n)\nORDER BY time;\n",
