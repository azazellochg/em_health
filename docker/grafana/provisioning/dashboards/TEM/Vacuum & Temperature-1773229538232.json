          "rawSql": "WITH state_param AS (\n    SELECT instrument_id, param_id, enum_id\n    FROM parameters\n    WHERE\n        instrument_id = 4\n        AND param_name = 'TMPAlState'\n        AND component = 'TMPal'\n),\n\nstate_enum AS (\n    SELECT\n        p.param_id,\n        e.value,\n        e.member_name\n    FROM\n        state_param p\n        JOIN enum_values e ON e.enum_id = p.enum_id\n)\n\nSELECT\n    d.time,\n    --d.value_num AS value,\n    lower(substring(se.member_name FROM '^PUMP_(.+)$')) AS state\nFROM\n    data d\n    JOIN state_enum se ON se.param_id=d.param_id\n    AND d.value_num = se.value\nWHERE d.instrument_id = 4\n    AND $__timeFilter(d.time)\n    AND se.member_name IN ('PUMP_RUNNING', 'PUMP_STOPPED', 'PUMP_STANDBY')\nORDER BY d.time",
