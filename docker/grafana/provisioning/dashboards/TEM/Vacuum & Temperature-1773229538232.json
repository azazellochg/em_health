          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH matching_params AS (\n  SELECT param_id, display_name\n  FROM parameters\n  WHERE instrument_id = $instrument\n    AND component = 'KriosTemperatures'\n    AND param_name IN ('TSample', 'Tcldwr', 'Taldwr', 'Tdocker', 'Tcassette', 'Tcartridge')\n)\n\nSELECT\n  time_bucket(INTERVAL '$__interval', d.time) AS time,\n  p.display_name,\n  AVG(d.value_num) AS temperature\nFROM data d\nJOIN matching_params p\n  ON d.param_id = p.param_id\nWHERE d.instrument_id = $instrument\n  AND $__timeFilter(d.time)\n  AND d.value_num != 0\nGROUP BY time, p.display_name\nORDER BY time;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
