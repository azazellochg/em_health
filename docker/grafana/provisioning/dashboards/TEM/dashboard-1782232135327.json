      "panel-27": {
        "kind": "Panel",
        "spec": {
          "id": 27,
          "title": "EPU drift measurement",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${sourceTEM}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH param_id AS (\n  SELECT\n    param_id\n  FROM parameters\n  WHERE\n    instrument_id = $instrument\n    AND subsystem = 'EPU'\n    AND component = 'Corrections'\n    AND param_name = 'DriftMeasurement'\n)\nSELECT\n    d.time AS time,\n    d.value_num * 10^9 AS \"Drift\"\nFROM data d\nJOIN param_id p ON p.param_id = d.param_id\nWHERE d.instrument_id = $instrument\n  AND $__timeFilter(d.time)\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
