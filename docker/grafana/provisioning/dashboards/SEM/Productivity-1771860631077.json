      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${sourceSEM}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH gis_params AS (\n  SELECT\n    instrument_id,\n    param_id,\n    component AS port\n  FROM parameters\n  WHERE instrument_id = $instrument\n    AND subsystem = 'GISes'\n    AND param_name LIKE 'GIS%ValveOpenTimeParameter'\n),\n\ngis_usage AS (\n    SELECT\n        port || ' usage',\n        last(value_num, time)/3600.0 AS gis_usage\n    FROM data d\n    JOIN gis_params p USING (instrument_id, param_id)\n    GROUP BY port\n),\n\nsource_param AS (\n  SELECT instrument_id, param_id\n  FROM parameters\n  WHERE instrument_id = $instrument\n    AND component = 'FIB'\n    AND param_name IN ('SourceAgeParameter', 'OperatingTimeFIBParameter')\n),\n\nsource_usage AS (\n  SELECT\n    'Source age',\n    last(value_num, time)/3600.0 AS source_age\n  FROM data\n  JOIN source_param p USING (instrument_id, param_id)\n  WHERE $__timeFilter(time) \n)\n\nSELECT * FROM gis_usage\nUNION ALL\nSELECT * FROM source_usage\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
