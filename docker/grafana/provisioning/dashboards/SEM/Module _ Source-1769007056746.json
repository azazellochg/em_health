      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "param_name"
              }
            ]
          }
        },
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "param_name",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "counts",
                "handlerKey": "field.value"
              }
            ]
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "I-Column.(.*)_PeakCount",
            "renamePattern": "$1"
          }
        }
      ],
      "type": "stat"
    },
