                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH counter_param AS (\n  SELECT instrument_id, param_id\n  FROM parameters\n  WHERE instrument_id IN ($instrument)\n    AND component = 'FIB'\n    AND param_name IN ('SourceAgeParameter', 'OperatingTimeFIBParameter')\n),\n\nlast_value AS (\n  SELECT last(d.value_num, d.time) AS source_age\n  FROM data d\n  JOIN counter_param p USING (instrument_id, param_id)\n),\n\nlast_replacement AS (\n  SELECT time\n  FROM (\n    SELECT time,\n           value_num,\n           lag(value_num) OVER (ORDER BY time DESC) AS next_value\n    FROM data d\n    JOIN counter_param p USING (instrument_id, param_id)\n  ) t\n  WHERE value_num > next_value   -- reset when going forward in time\n  ORDER BY time DESC\n  LIMIT 1\n)\n\nSELECT\n  lv.source_age / 3600 AS \"Source age\",\n  lr.time AS \"Last replacement\"\nFROM last_value lv\nLEFT JOIN last_replacement lr ON true;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
