        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${sourceSEM}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH cagg AS (\n  SELECT\n    time_bucket('1 day', d.time) AS day,\n    delta(counter_agg(d.time, d.value_num)) AS daily_usage,\n    substring(p.param_name FROM '^GasUsage_(.+)Parameter$') AS gas_type\n  FROM\n    data d\n    JOIN parameters p USING (param_id, instrument_id)\n  WHERE\n    d.instrument_id = $instrument\n    AND $__timeFilter(d.time)\n    AND p.component = 'FIB'\n    AND p.param_name LIKE 'GasUsage_%Parameter'\n  GROUP BY day, gas_type\n)\n\nSELECT\n  day AS time,\n  gas_type AS name,\n  daily_usage AS value\nFROM cagg\nORDER BY day\n",
          "refId": "counters",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "PFIB gas usage",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^value (.*)",
            "renamePattern": "$1"
          }
        }
      ],
