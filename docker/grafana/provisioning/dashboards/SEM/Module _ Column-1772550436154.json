          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH cagg AS (\n  SELECT\n    p.enum_id,\n    state_agg(d.time, d.value_num :: int) AS agg\n  FROM\n    data d\n    JOIN parameters p USING (instrument_id, param_id)\n  WHERE\n    d.instrument_id = $instrument \n    AND $__timeFilter(d.time)\n    AND p.component = 'Chamber'\n    AND p.param_name = 'Chamber.StateSC'\n  GROUP BY\n    p.enum_id\n)\n\nSELECT\n  ev.member_name AS \"State\",\n  COUNT(*) AS \"Count\"\nFROM\n  cagg\n  CROSS JOIN LATERAL state_int_timeline(agg) s\n  JOIN enum_values ev ON ev.enum_id = cagg.enum_id AND ev.value = s.state\nGROUP BY ev.member_name\nORDER BY \"Count\" DESC",
          "refId": "A",
          "sql": {
