      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${sourceSEM}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH total AS (\n  SELECT\n    gis_port,\n    MAX(day) AS last_day,\n    last_val(rollup(agg)) AS total_usage\n  FROM gis_counters_daily\n  WHERE instrument_id = $instrument\n    AND $__timeFilter(day) \n  GROUP BY gis_port\n),\n\ndaily AS (\n  SELECT\n    gis_port,\n    AVG(delta(agg)) AS daily_avg\n  FROM gis_counters_daily\n    WHERE instrument_id = $instrument\n      AND $__timeFilter(day)\n    GROUP BY gis_port\n)\n\nSELECT\n  t.gis_port AS \"Port\",\n  COALESCE(d.daily_avg, 0) AS \"Daily usage\",\n  t.total_usage/3600.0 AS \"Total usage (h)\",\n  t.total_usage/3600.0/120*100 AS \"Total usage (%)\"\nFROM total t\nLEFT JOIN daily d USING (gis_port)\nORDER BY t.gis_port\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
