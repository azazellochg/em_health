                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH target_params AS (\n  SELECT \n    substring(param_name FROM 'Stages\\.(.+)$') AS component,\n    param_id, enum_id\n  FROM parameters\n  WHERE instrument_id = $instrument\n    AND component = 'SystemStatus'\n    AND param_name LIKE 'Stages.%'\n),\nlatest_data AS (\n  SELECT DISTINCT ON (param_id) *\n  FROM data\n  WHERE instrument_id = $instrument\n    AND param_id IN (SELECT param_id FROM target_params)\n    AND $__timeFilter(time)\n  ORDER BY param_id, time DESC\n)\nSELECT\n  'Stage: ' || tp.component AS name,\n  ev.member_name AS value_num,\n  ld.time\nFROM target_params tp\nJOIN latest_data ld\n  ON ld.param_id = tp.param_id\nJOIN enum_values ev\n  ON ev.enum_id = tp.enum_id\n  AND ld.value_num = ev.value\nORDER BY ld.time DESC;\n",
                        "sql": {
