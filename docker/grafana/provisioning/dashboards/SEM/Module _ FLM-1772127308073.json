          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\n    d.time AS \"Time\",\n    p.param_name AS \"Component\",\n    e.member_name AS \"Error\"\nFROM data d\nJOIN parameters p\n    ON p.param_id = d.param_id\n    AND p.instrument_id = $instrument\n    AND p.component = 'RetractableObjective'\n    AND p.param_name LIKE 'Retractable%State'\n    AND p.subsystem = 'FLM'\nJOIN enum_values e\n    ON e.enum_id = p.enum_id\n    AND e.value = d.value_num\n    AND e.member_name IN (\n        'OverTemperature',\n        'PositionerFault',\n        'PowerSupplyOverload',\n        'PowerSupplyFailure',\n        'Error'\n    )\nWHERE $__timeFilter(d.time)\nORDER BY d.time DESC",
          "refId": "A",
          "sql": {
