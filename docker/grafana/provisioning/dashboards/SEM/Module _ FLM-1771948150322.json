          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH matching_params AS (\n  SELECT param_id, param_name, enum_id\n  FROM parameters\n  WHERE instrument_id = $instrument \n  AND component = 'RetractableObjective'\n  AND param_name LIKE 'Retractable%State'\n  AND subsystem = 'FLM'\n),\n\nerror_states AS (\n  SELECT p.param_id, p.param_name, e.member_name, e.value\n  FROM enum_values e\n  JOIN matching_params p USING (enum_id)\n  WHERE e.member_name IN ('OverTemperature', 'PositionerFault', 'PowerSupplyOverload', 'PowerSupplyFailure', 'Error')\n)\n\nSELECT\n  d.time AS \"Time\",\n  e.param_name AS \"Component\",\n  e.member_name AS \"Error\"\nFROM data d\nJOIN error_states e ON e.param_id = d.param_id\n  AND e.value = d.value_num\nWHERE d.instrument_id = $instrument \n  AND $__timeFilter(d.time)\nORDER BY d.time DESC\n",
          "refId": "obj",
          "sql": {
