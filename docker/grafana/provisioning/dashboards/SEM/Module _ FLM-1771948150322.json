          "rawSql": "WITH matching_param AS (\n  SELECT param_id, enum_id\n  FROM parameters p\n  WHERE instrument_id = $instrument\n    AND subsystem = 'FLM'\n    AND component = 'FilterExchanger'\n    AND param_name = 'FilterSwitcherFaultState'\n),\n\nnoerror_state AS (\n  SELECT p.param_id, e.value\n  FROM enum_values e\n  JOIN matching_param p USING (enum_id)\n  WHERE e.member_name = 'None'\n)\n\nSELECT\n  d.time,\n  d.value_num\nFROM\n  data d\n  JOIN noerror_state ns ON ns.param_id = d.param_id\n    AND d.value_num != ns.value\nWHERE\n  instrument_id = $instrument\n  AND $__timeFilter(d.time)\nORDER BY\n  d.time\n",
