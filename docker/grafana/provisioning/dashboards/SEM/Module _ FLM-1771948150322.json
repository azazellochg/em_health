          "rawQuery": true,
          "rawSql": "WITH state_param AS (\n  SELECT\n    param_id,\n    enum_id\n  FROM\n    parameters p\n  WHERE\n    p.instrument_id = $instrument\n    AND p.param_name = 'FilterSwitcherFilterType'\n    AND p.subsystem = 'FLM'\n),\n\nstate_enum AS (\n  SELECT\n    p.param_id,\n    e.member_name,\n    e.value\n  FROM\n    enum_values e\n    JOIN state_param p USING (enum_id)\n),\n\nstates AS (\n  SELECT\n    state,\n    duration\n  FROM\n    toolkit_experimental.into_int_values((\n        SELECT\n          toolkit_experimental.compact_state_agg(d.time, d.value_num :: bigint) AS agg\n        FROM\n          data d\n        JOIN state_param p USING (param_id)\n        WHERE\n          d.instrument_id = $instrument\n          AND $__timeFilter(d.time)\n      ))\n)\n\nSELECT\n  e.member_name AS state,\n  EXTRACT(EPOCH FROM s.duration) AS duration\nFROM\n  states s\n  JOIN state_enum e ON e.value = s.state\n  ",
          "refId": "A",
