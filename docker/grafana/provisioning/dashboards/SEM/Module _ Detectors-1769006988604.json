          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH matching_param AS (\n  SELECT\n    component,\n    param_id\n  FROM\n    parameters p\n  WHERE\n    instrument_id = $instrument\n    AND subsystem = 'Detectors'\n    AND param_name = 'EtdEnabledParameter'\n)\nSELECT\n  v.time,\n  p.component,\n  v.value_num\nFROM\n  data v\n  JOIN matching_param p ON v.param_id = p.param_id\nWHERE\n  instrument_id = $instrument\n  AND $__timeFilter(v.time)\nORDER BY\n  v.time",
          "refId": "etd",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${sourceSEM}"
          },
          "editorMode": "code",
          "format": "time_series",
          "hide": false,
          "rawQuery": true,
          "rawSql": "WITH matching_param AS (\n    SELECT param_id, enum_id\n    FROM parameters\n    WHERE\n        instrument_id = $instrument\n        AND subsystem = 'Imaging'\n        AND component = 'PIA4'\n        AND param_name = 'CappStateParameter'\n),\n\noffline_value AS (\n    SELECT \n        e.value AS expected_value_num,\n        mp.param_id\n    FROM matching_param mp\n    JOIN enum_values e ON e.enum_id = mp.enum_id\n    WHERE e.member_name = 'Offline'\n)\n\nSELECT\n    v.time,\n    'PIA4' AS component,\n    CASE \n        WHEN v.value_num = x.expected_value_num THEN 0\n        ELSE 1\n    END AS value_num\nFROM data v\nJOIN offline_value x ON v.param_id = x.param_id\nWHERE\n    v.instrument_id = $instrument\n    AND $__timeFilter(v.time)\nORDER BY v.time;\n",
          "refId": "pia4",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${sourceSEM}"
          },
          "editorMode": "code",
          "format": "time_series",
          "hide": false,
          "rawQuery": true,
          "rawSql": "WITH matching_param AS (\n    SELECT param_id, enum_id\n    FROM parameters\n    WHERE\n        instrument_id = $instrument\n        AND subsystem = 'Imaging'\n        AND component = 'NavCam'\n        AND param_name = 'NavCamStateParameter'\n),\n\noffline_value AS (\n    SELECT \n        e.value AS expected_value_num,\n        mp.param_id\n    FROM matching_param mp\n    JOIN enum_values e ON e.enum_id = mp.enum_id\n    WHERE e.member_name = 'Offline'\n)\n\nSELECT\n    v.time,\n    'NavCam' AS component,\n    CASE \n        WHEN v.value_num = x.expected_value_num THEN 0\n        ELSE 1\n    END AS value_num\nFROM data v\nJOIN offline_value x ON v.param_id = x.param_id\nWHERE\n    v.instrument_id = $instrument\n    AND $__timeFilter(v.time)\nORDER BY v.time;\n",
          "refId": "navcam",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
