      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${sourceSEM}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH daily_totals AS (\n  SELECT\n    day,\n    SUM(seconds) AS total_seconds\n  FROM vacuum_state_daily\n  WHERE $__timeFilter(day)\n    AND instrument_id = $instrument\n  GROUP BY day\n)\nSELECT\n  v.day AS \"time\",\n  v.state,\n  100.0 * SUM(v.seconds) / NULLIF(t.total_seconds, 0) AS percentage\nFROM vacuum_state_daily v\nJOIN daily_totals t\n  ON v.day = t.day\nWHERE $__timeFilter(v.day)\n  AND v.instrument_id = $instrument\nGROUP BY v.day, v.state, t.total_seconds\nORDER BY v.day, v.state;\n",
          "refId": "A",
