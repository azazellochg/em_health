          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  SUM(ec.total_image_counter) AS total_images,\n  ROUND(AVG(ec.total_image_counter)) AS avg_images_per_session,\n  COALESCE(EXTRACT(EPOCH FROM SUM(er.running_duration)), 0) AS total_running_duration,\n  SUM(ec.skip_image_counter) AS total_skipped_images,\n\n  -- terminated counts\n  SUM(CASE WHEN er.has_terminated = TRUE  THEN 1 ELSE 0 END) AS terminated_count,\n  SUM(CASE WHEN er.has_terminated = FALSE THEN 1 ELSE 0 END) AS completed_count\n\nFROM epu_counters ec\nJOIN epu_sessions es\n  ON es.session_id = ec.session_id\n  AND es.start_time = ec.start_time\nJOIN epu_runs er\n  ON er.session_id = ec.session_id\n  AND er.start_time = ec.start_time\n\nWHERE ec.instrument_id = $instrument\n  AND es.instrument_id = $instrument\n  AND er.instrument_id = $instrument\n  AND $__timeFilter(es.start_time)",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
