          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH total AS (\n  SELECT SUM(seconds) AS total_seconds\n  FROM sem_beamtime_daily\n  WHERE $__timeFilter(day)\n    AND instrument_id = $instrument \n)\nSELECT\n  v.state,\n  SUM(v.seconds) AS duration_seconds,\n  ROUND(\n      100.0 * SUM(v.seconds) / NULLIF(t.total_seconds, 0),\n      2\n  ) AS percentage\nFROM sem_beamtime_daily v\nCROSS JOIN total t\nWHERE $__timeFilter(v.day)\n  AND v.instrument_id = $instrument \nGROUP BY v.state, t.total_seconds\nORDER BY percentage DESC\n",
          "refId": "A",
          "sql": {
            "columns": [
