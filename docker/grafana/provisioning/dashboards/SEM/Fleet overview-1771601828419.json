      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${sourceSEM}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH total AS (\n  SELECT\n    (SELECT EXTRACT(EPOCH FROM SUM(running_duration))\n     FROM epu_running_daily\n     WHERE instrument_id = $instrument\n       AND $__timeFilter(time)) AS total_epu_seconds,\n    (SELECT EXTRACT(EPOCH FROM SUM(running_duration))\n     FROM tomo_running_daily\n     WHERE instrument_id = $instrument\n       AND $__timeFilter(time)) AS total_tomo_seconds\n)\nSELECT\n  ROUND(COALESCE(total_epu_seconds, 0) / NULLIF(($__to - $__from) / 1000.0, 0) * 100.0, 2) AS epu_utilization_percent,\n  ROUND(COALESCE(total_tomo_seconds, 0) / NULLIF(($__to - $__from) / 1000.0, 0) * 100.0, 2) AS tomo_utilization_percent\nFROM total;\n",
          "refId": "uptime",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
