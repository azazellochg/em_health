      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH memory_config AS (\n  SELECT\n    pg_size_bytes(current_setting('shared_buffers')) AS shared_buffers_bytes\n),\nchunk_sizes AS (\n  SELECT\n    hypertable_name,\n    chunk_name,\n    pg_total_relation_size(format('%I.%I', chunk_schema, chunk_name)) AS chunk_bytes\n  FROM\n    timescaledb_information.chunks\n  WHERE\n    NOT is_compressed\n),\nmax_chunks AS (\nSELECT\n  hypertable_name,\n  count(*) AS chunk_count,\n  pg_size_pretty(avg(chunk_bytes) :: bigint) AS avg_chunk_size,\n  pg_size_pretty(max(chunk_bytes)) AS max_chunk_size,\n  max(chunk_bytes) :: numeric / shared_buffers_bytes * 100 AS max_chunk_pct_of_shared_buffers\nFROM\n  chunk_sizes,\n  memory_config\nGROUP BY\n  hypertable_name,\n  shared_buffers_bytes\n)\nSELECT \n  AVG(mc.max_chunk_pct_of_shared_buffers) AS chunks_percent,\n  MAX(mem.shared_buffers_bytes)/1000 AS shared_buffers,\n  AVG(ps.mem_total) AS mem_total\nFROM max_chunks mc\nCROSS JOIN memory_config mem\nCROSS JOIN pganalyze.sys_stats ps\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Chunk size vs shared_buffers",
      "type": "stat"
