          "rawQuery": true,
          "rawSql": "SELECT\n  AVG(100.0 * s.heap_blks_hit / NULLIF(s.heap_blks_hit + s.heap_blks_read, 0)) AS hit_ratio_percent\nFROM\n  pg_statio_user_tables s\n  JOIN timescaledb_information.chunks c ON s.relname = c.chunk_name\nWHERE c.is_compressed = false\n  AND c.range_start > now() - interval '30 days'",
