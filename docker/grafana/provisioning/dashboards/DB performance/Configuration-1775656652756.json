      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${source}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH compressed_tables AS (\n    SELECT hypertable_schema, hypertable_name\n    FROM timescaledb_information.hypertables\n    WHERE compression_enabled = true\n),\nchunk_counts AS (\n    SELECT hypertable_schema, hypertable_name, COUNT(*) AS chunk_count\n    FROM timescaledb_information.chunks\n    GROUP BY hypertable_schema, hypertable_name\n)\nSELECT\n    t.hypertable_schema || '.' || t.hypertable_name AS hypertable,\n    cc.chunk_count,\n    pg_size_pretty(s.before_compression_total_bytes) AS before_size,\n    pg_size_pretty(s.after_compression_total_bytes) AS after_size,\n    ROUND(\n        s.before_compression_total_bytes::numeric\n        / NULLIF(s.after_compression_total_bytes,0), 1\n    ) AS compression_ratio,\n    CASE\n        WHEN s.before_compression_total_bytes::numeric\n             / NULLIF(s.after_compression_total_bytes,1) < 2\n        THEN 'POOR — review segmentby'\n        ELSE 'OK'\n    END AS result\nFROM compressed_tables t\nJOIN chunk_counts cc\n  ON cc.hypertable_schema = t.hypertable_schema\n AND cc.hypertable_name = t.hypertable_name\nJOIN LATERAL hypertable_compression_stats(\n    t.hypertable_schema || '.' || t.hypertable_name\n) AS s ON TRUE\nORDER BY hypertable",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
