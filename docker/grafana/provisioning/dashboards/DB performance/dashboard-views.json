                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  pm.schemaname || '.' || pm.matviewname AS \"View\",\n  pm.hasindexes AS \"Indexed?\",\n  pg_total_relation_size(\n    format('%I.%I', pm.schemaname, pm.matviewname) :: regclass\n  ) AS \"Object size\",\n  approximate_row_count(\n    format('%I.%I', pm.schemaname, pm.matviewname) :: regclass\n  ) AS \"Approx. row count\",\n  st.n_dead_tup AS \"Dead tuples\"\nFROM\n  pg_matviews pm\n  LEFT JOIN pg_catalog.pg_stat_user_tables st ON st.schemaname = pm.schemaname\n  AND st.relname = pm.matviewname\nORDER BY\n  pm.schemaname,\n  pm.matviewname",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
