                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${source}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH cagg_check AS (\n  SELECT\n    c.view_schema,\n    c.view_name\n  FROM timescaledb_information.continuous_aggregates c\n  WHERE c.view_schema || '.' || c.view_name = '$viewname'\n)\nSELECT\n  j.job_id,\n  (policy ->> 'refresh_interval')::interval AS schedule_interval,\n  policy ->> 'refresh_start_offset' AS start_offset,\n  policy ->> 'refresh_end_offset' AS end_offset\nFROM\n  timescaledb_experimental.show_policies('$viewname') AS policy\nJOIN cagg_check c\n  ON true\nLEFT JOIN timescaledb_information.jobs j\n  ON j.hypertable_schema = c.view_schema\n AND j.hypertable_name = c.view_name\n AND j.proc_name = 'policy_refresh_continuous_aggregate';",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
