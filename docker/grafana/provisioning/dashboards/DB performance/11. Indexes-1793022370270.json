      "panel-48": {
        "kind": "Panel",
        "spec": {
          "id": 48,
          "title": "Unused indexes (non-PK)",
          "description": "Scans < 10",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${source}"
                      },
                      "spec": {
                        "dataset": "tem",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  s.indexrelname AS \"Index\",\n  format('%I.%I', s.schemaname, s.relname) AS \"Table\",\n  s.idx_scan AS \"Scans\"\nFROM\n  pg_stat_user_indexes s\n  JOIN pg_index i USING (indexrelid)\nWHERE\n  NOT i.indisprimary\n  AND s.idx_scan <10\n  AND s.schemaname NOT IN ('pg_catalog', 'information_schema')\n  AND s.schemaname NOT LIKE '_timescaledb%'\nORDER BY s.schemaname, s.relname",
