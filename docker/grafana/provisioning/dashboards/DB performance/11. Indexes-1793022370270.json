      "panel-49": {
        "kind": "Panel",
        "spec": {
          "id": 49,
          "title": "Duplicate indexes",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${source}"
                      },
                      "spec": {
                        "dataset": "tem",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    idx.relname AS \"Index\",\n    format('%I.%I', ns.nspname, tbl.relname) AS \"Table\"\nFROM pg_index i\nJOIN pg_class idx ON idx.oid = i.indexrelid\nJOIN pg_class tbl ON tbl.oid = i.indrelid\nJOIN pg_namespace ns ON ns.oid = tbl.relnamespace\nJOIN pg_am am ON am.oid = idx.relam\nWHERE i.indisvalid\nGROUP BY\n    i.indrelid,\n    i.indkey,\n    i.indclass,\n    i.indcollation,\n    i.indoption,\n    i.indexprs,\n    i.indpred,\n    i.indisunique,\n    am.amname,\n    idx.relname,\n    ns.nspname,\n    tbl.relname\nHAVING COUNT(*) > 1",
                        "sql": {
                          "columns": [
