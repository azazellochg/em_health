      "panel-46": {
        "kind": "Panel",
        "spec": {
          "id": 46,
          "title": "Top 10 biggest indexes",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${source}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH last_timestamp AS (\n  SELECT MAX(collected_at) AS time\n  FROM pganalyze.index_stats\n)\n\nSELECT\n  c.relname AS \"Index\",\n  i.schemaname || '.' || s.relid::regclass AS \"Table\",\n  s.size_bytes AS \"Size\",\n  b.bloat_ratio_percent AS \"Est. bloat\",\n  s.scan AS \"Scans\",\n  i.last_idx_scan AS \"Last scan\"\nFROM\n  pganalyze.index_stats s\n  JOIN pg_stat_user_indexes i USING (relid)\n  JOIN pg_class c ON c.oid = i.indexrelid\n  LEFT JOIN pganalyze.index_bloat b ON b.indexrelname = c.relname\nWHERE \n  collected_at = (SELECT time from last_timestamp)\nORDER BY s.size_bytes DESC\nLIMIT 10",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "labels": {
                        "grafana.app/export-label": "grafana-postgresql-datasource-1",
                        "grafana.app/export-datasource-name": "${source}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
