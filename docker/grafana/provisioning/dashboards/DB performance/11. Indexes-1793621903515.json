                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "tem",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH latest AS (\n  SELECT\n    DISTINCT ON (i.indexrelid) i.indexrelid,\n    format('%I.%I', s.schemaname, s.relname) AS \"Table\",\n    s.indexrelname AS \"Index\",\n    i.scan AS \"Scans\"\n  FROM\n    pganalyze.index_stats i\n    JOIN pg_stat_user_indexes s USING (indexrelid)\n  WHERE\n    s.indexrelname NOT LIKE '%_pkey'\n  ORDER BY\n    i.indexrelid,\n    i.collected_at DESC\n)\nSELECT\n  \"Table\",\n  \"Index\",\n  \"Scans\"\nFROM\n  latest\nWHERE\n  \"Scans\" < 10\nORDER BY\n  \"Table\"",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
