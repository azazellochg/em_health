      "panel-46": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${source}"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH last_timestamp AS (\n  SELECT MAX(collected_at) AS time\n  FROM pganalyze.index_stats\n)\n\nSELECT\n  i.indexrelname AS \"Index\",\n  i.schemaname || '.' || i.relname AS \"Table\",\n  s.size_bytes AS \"Size\",\n  b.bloat_ratio_percent AS \"Est. bloat\",\n  s.scan AS \"Scans\",\n  i.last_idx_scan AS \"Last scan\"\nFROM\n  pganalyze.index_stats s\n  JOIN pg_stat_user_indexes i USING (indexrelid)\n  LEFT JOIN pganalyze.index_bloat b ON b.indexrelname = i.indexrelname\nWHERE \n  collected_at = (SELECT time from last_timestamp)\nORDER BY s.size_bytes DESC\nLIMIT 10",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
