                        "rawQuery": true,
                        "rawSql": "SELECT\n  s.indexrelname AS \"Index\",\n  format('%I.%I', s.schemaname, s.relname) AS \"Table\"\nFROM\n  pg_stat_user_indexes s\n  JOIN pg_index i USING (indexrelid)\nWHERE\n  NOT i.indisvalid\n  AND s.schemaname NOT IN ('pg_catalog', 'information_schema')",
