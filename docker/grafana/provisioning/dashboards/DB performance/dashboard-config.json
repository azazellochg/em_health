      "panel-33": {
        "kind": "Panel",
        "spec": {
          "id": 33,
          "title": "Tuning work_mem",
          "description": "For most TimescaleDB servers, 64 MB to 256 MB is appropriate.\n\nwork_mem controls how much memory PostgreSQL allocates for each sort, hash join, or hash aggregate operation before spilling to temporary files on disk. The critical detail: this is per operation, not per connection. ",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    pg_size_bytes(current_setting('work_mem')) / 1024 / 1024 AS current_value,\n    GREATEST(\n        1,\n        LEAST(\n            256,\n            pg_size_bytes(current_setting('shared_buffers')) /\n            current_setting('max_connections')::int / 1024 / 1024\n        )\n    ) AS recommended",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.1.0-25893932881",
            "spec": {
              "options": {
