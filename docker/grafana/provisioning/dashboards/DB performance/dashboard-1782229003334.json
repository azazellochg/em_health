            "text": "WITH bucketed AS (\n    SELECT\n        time_bucket(INTERVAL $1, collected_at) AS bucket,\n        delta(counter_agg(collected_at, calls)) AS delta_calls,\n        delta(counter_agg(collected_at, total_plan_time))  \n        delta(counter_agg(collected_at, total_exec_time)) AS delta_total_time,\n        delta(counter_agg(collected_at, blk_read_time))  \n        delta(counter_agg(collected_at, blk_write_time)) AS delta_total_io\n    FROM pganalyze.stat_statements\n    WHERE collected_at BETWEEN $2 AND $3\n    GROUP BY bucket, queryid\n)\nSELECT\n    bucket AS time,\n    approx_percentile($4, percentile_agg(delta_total_time / NULLIF(delta_calls,$5))) AS \"Median time\",\n    approx_percentile($6, percentile_agg(delta_total_time / NULLIF(delta_calls,$7))) AS \"P95 time\",\n    SUM(delta_total_io) / NULLIF(SUM(delta_calls),$8) AS \"Avg I/O time\"\nFROM bucketed\nWHERE delta_calls > $9\nGROUP BY bucket\nORDER BY bucket",
