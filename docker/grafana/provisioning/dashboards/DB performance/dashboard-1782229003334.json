      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Query runtime",
          "description": "Per call statistics over time",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "${source}"
                      },
                      "spec": {
                        "dataset": "tem",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH bucketed AS (\n    SELECT\n        time_bucket(INTERVAL '$__interval', collected_at) AS bucket,\n        delta(counter_agg(collected_at, calls)) AS delta_calls,\n        delta(counter_agg(collected_at, total_plan_time)) +\n        delta(counter_agg(collected_at, total_exec_time)) AS delta_total_time,\n        delta(counter_agg(collected_at, blk_read_time)) +\n        delta(counter_agg(collected_at, blk_write_time)) AS delta_total_io\n    FROM pganalyze.stat_statements\n    WHERE $__timeFilter(collected_at)\n    GROUP BY bucket, queryid\n)\nSELECT\n    bucket AS time,\n    approx_percentile(0.5, percentile_agg(delta_total_time / NULLIF(delta_calls,0))) AS \"Median time\",\n    approx_percentile(0.95, percentile_agg(delta_total_time / NULLIF(delta_calls,0))) AS \"P95 time\",\n    SUM(delta_total_io) / NULLIF(SUM(delta_calls),0) AS \"Avg I/O time\"\nFROM bucketed\nWHERE delta_calls > 0\nGROUP BY bucket\nORDER BY bucket\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
