                      "spec": {
                        "dataset": "tem",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH agg AS (\n    SELECT\n        userid,\n        queryid,\n        delta(counter_agg(collected_at, calls)) AS total_calls,\n        delta(counter_agg(collected_at, total_plan_time)) AS total_plan_time,\n        delta(counter_agg(collected_at, total_exec_time)) AS total_exec_time,\n        delta(counter_agg(collected_at, blk_read_time)) AS total_blk_read_time,\n        delta(counter_agg(collected_at, blk_write_time)) AS total_blk_write_time\n    FROM pganalyze.stat_statements\n    WHERE $__timeFilter(collected_at)\n    GROUP BY queryid, userid\n)\nSELECT\n    a.queryid::text,\n    q.query AS \"Query\",\n    ((a.total_plan_time + a.total_exec_time) / NULLIF(a.total_calls, 0)) AS \"Avg time\",\n    (a.total_calls / NULLIF((($__to - $__from) / 1000) / 60, 0)) AS \"Calls/min\",\n    ((a.total_plan_time + a.total_exec_time) / NULLIF(SUM(a.total_plan_time + a.total_exec_time) OVER (), 0) * 100) AS \"% of all runtime\",\n    ((a.total_blk_read_time + a.total_blk_write_time) / NULLIF(SUM(a.total_blk_read_time + a.total_blk_write_time) OVER (), 0) * 100) AS \"% of all I/O\",\n    r.rolname AS \"User\"\nFROM agg a\nJOIN pganalyze.queries q ON q.queryid = a.queryid\nJOIN pg_roles r ON r.oid = a.userid\nWHERE a.total_calls > 0\nORDER BY \"Avg time\" DESC;",
                        "sql": {
